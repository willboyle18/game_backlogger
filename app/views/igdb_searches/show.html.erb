<div class="mx-auto max-w-3xl mt-8 px-4">
  <h1 class="text-2xl font-semibold tracking-tight mb-4">Search IGDB</h1>

  <%= form_with url: igdb_search_path, method: :get, local: true, class: "flex gap-2 mb-6" do %>
    <%= text_field_tag :q, @query, placeholder: "Type a game title…",
                       class: "flex-1 rounded-md border border-slate-300 px-3 py-2" %>
    <%= submit_tag "Search",
                   class: "rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" %>
  <% end %>

  <% if @query.present? %>
    <p class="text-sm text-slate-500 mb-3">
      Showing results for: <span class="font-medium"><%= @query %></span>
    </p>
  <% end %>

  <% if @results.blank? && @query.present? %>
    <p class="text-slate-600">No results found.</p>
  <% end %>

  <ul class="space-y-3">
    <% @results.each do |g| %>
      <li class="flex items-center justify-between rounded-lg border border-slate-200 bg-white px-4 py-3">
        <div class="min-w-0">
          <div class="font-medium text-slate-900 truncate"><%= g["name"] %></div>
          <div class="text-sm text-slate-600">
            <% year = g["first_release_date"] ? Time.at(g["first_release_date"]).year : "Unknown" %>
            <span><%= year %></span>
            <% if (plats = g.dig("platforms")) %>
              • <%= plats.map { _1["name"] }.compact.join(", ") %>
            <% end %>
          </div>
        </div>

        <% if (cover = g.dig("cover", "url")) %>
          <img
            src="<%= cover.start_with?('//') ? "https:#{cover}" : cover %>"
            alt="<%= g["name"] %> cover"
            class="h-12 w-9 rounded object-cover ml-4" />
        <% end %>

        <%= button_to "Add to backlog", backlog_items_path(igdb_id: g["id"], q: @query),
                      method: :post,
                      class: "cursor-pointer border"%>
      </li>
    <% end %>
  </ul>
</div>