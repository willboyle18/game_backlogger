<h1 class="text-2xl font-bold mb-4">Friends</h1>

<!-- Current Friends -->
<section class="mb-8">
  <h2 class="text-xl font-semibold mb-2">Current Friends</h2>
  <% if @current_friends.any? %>
    <ul>
      <% @current_friends.each do |f| %>
        <li class="flex justify-between border-b py-2">
          <span><%= f.email_address %></span>

          <% friendship = Friend.find_by(user: Current.user, friend: f) ||
                          Friend.find_by(user: f, friend: Current.user) %>

          <%= button_to "Remove", friend_path(friendship),
                        method: :delete, class: "text-red-600 hover:underline" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500">No friends yet.</p>
  <% end %>
</section>

<!-- Outgoing -->
<section class="mb-8">
  <h2 class="text-xl font-semibold mb-2">Outgoing Requests</h2>
  <% @outgoing_requests.each do |req| %>
    <p><%= req.email_address %> (pending)</p>
  <% end %>
</section>


<!-- Incoming -->
<section class="mb-8">
  <h2 class="text-xl font-semibold mb-2">Incoming Requests</h2>
  <% @incoming_requests.each do |req| %>
    <div class="flex items-center justify-between">
      <span><%= req.email_address %></span>
      <%= button_to "Accept", friend_path(req), method: :patch, class: "text-green-600" %>
    </div>
  <% end %>
</section>
