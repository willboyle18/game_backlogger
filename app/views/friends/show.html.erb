<div class="mb-8">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-semibold tracking-tight"><%= @friend.username %>'s Backlog</h1>
  </div>

  <% if @backlog_items.empty? %>
    <p class="text-slate-600"><%= @friend.username %>'s backlog is empty.</p>
  <% else %>
    <ul class="space-y-3">
      <% @backlog_items.each do |item| %>
        <li class="flex items-center justify-between rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm hover:shadow transition">
          <%= link_to item.game.name, game_path(item.game.igdb_id),
                      class: "font-medium text-slate-800 hover:underline" %>
          Status: <%= item.status.humanize %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

<div class="mb-8">
  <h1><%= @friend.username %>'s Reviews</h1>
  <% if @reviews.any? %>
    <ul class="space-y-4">
      <% @reviews.each do |review| %>
        <li class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
          <div class="flex justify-between items-center">
            <span class="font-medium text-slate-900"><%= review.user.username %></span>
            <span class="text-sm text-slate-500"><%= time_ago_in_words(review.created_at) %> ago</span>
            <span class="font-medium text-slate-900"><%= review.game.name %></span>
          </div>

          <p class="mt-2 text-slate-700 whitespace-pre-wrap"><%= review.body %></p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-slate-600"><%= @friend.username %> has not left any reviews yet!</p>
  <% end %>
</div>

<div class="mb-8">
  <h1>Profile Comments</h1>
  <% if @comments.any? %>
    <ul class="space-y-4">
      <% @comments.each do |comment| %>
        <li class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
          <div class="flex justify-between items-center">
            <span class="font-medium text-slate-900"><%= comment.user.username %></span>
            <span class="text-sm text-slate-500"><%= time_ago_in_words(comment.created_at) %> ago</span>
          </div>
          <p class="mt-2 text-slate-700 whitespace-pre-wrap"><%= comment.body %></p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-slate-600"><%= @friend.username %> has not received any comments yet! Be the first to write one!</p>
  <% end %>
</div>

<%= form_with model: [@friend, Comment.new] do |f| %>
  <%= f.text_area :body,
                  placeholder: "Leave a comment...",
                  rows: 6, cols: 60,
                  class: "border border-slate-300 rounded-md px-3 py-2 w-full" %>
  <%= f.submit "Post comment",
               class: "bg-blue-600 hover:bg-blue-500 text-white rounded-md px-4 py-2 cursor-pointer mt-2" %>
<% end %>