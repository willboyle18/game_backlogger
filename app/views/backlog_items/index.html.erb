<div class="mb-8">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-semibold tracking-tight">My Backlog</h1>
  </div>

  <% if @backlog_items.empty? %>
    <p class="text-slate-600">Your backlog is empty.</p>
  <% else %>
    <ul class="space-y-3">
      <% @backlog_items.each do |item| %>
        <li class="flex items-center justify-between rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm hover:shadow transition">
          <%= link_to item.game.name, game_path(item.game.igdb_id),
                      class: "font-medium text-slate-800 hover:underline" %>

          Status:
          <%= form_with model: item, url: backlog_item_path(item), method: :patch, local: true do |f| %>
            <%= f.select :status,
                         BacklogItem.statuses.keys.map { |s| [s.humanize, s] },
                         { selected: item.status },
                         class: "border rounded p-1 text-sm",
                         onchange: "this.form.submit()" %>
          <% end %>

          <%= button_to "Remove",
                        backlog_item_path(item),
                        method: :delete,
                        form: { data: { turbo_confirm: "Remove from backlog?" } },
                        class: "rounded-md border border-slate-300 px-3 py-1 text-sm text-slate-700 hover:bg-slate-100" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-semibold tracking-tight">Profile Comments</h1>
  </div>
  <% if @comments.any? %>
    <ul class="space-y-4">
      <% @comments.each do |comment| %>
        <li class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
          <div class="flex justify-between items-center">
            <span class="font-medium text-slate-900"><%= comment.user.username %></span>
            <span class="text-sm text-slate-500"><%= time_ago_in_words(comment.created_at) %> ago</span>
          </div>
          <p class="mt-2 text-slate-700 whitespace-pre-wrap"><%= comment.body %></p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-slate-600">You have not received any comments yet!</p>
  <% end %>

  <%= form_with model: [Current.user, Comment.new] do |f| %>
    <%= f.text_area :body,
                    placeholder: "Leave a comment...",
                    rows: 6, cols: 60,
                    class: "border border-slate-300 rounded-md px-3 py-2 w-full" %>
    <%= f.submit "Post comment",
                 class: "bg-blue-600 hover:bg-blue-500 text-white rounded-md px-4 py-2 cursor-pointer mt-2" %>
  <% end %>

</div>

<div class="mb-8">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-semibold tracking-tight">Reviews</h1>
  </div>
  <% if @reviews.any? %>
    <ul class="space-y-4">
      <% @reviews.each do |review| %>
        <%= link_to game_review_path(review.game.igdb_id, review),
                    class: "block rounded-lg border border-slate-200 bg-white p-4 shadow-sm hover:shadow-md transition" do %>
          <li class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
            <div class="flex justify-between items-center">
              <span class="font-medium text-slate-900"><%= review.game.name %></span>
              <span class="text-sm text-slate-500"><%= time_ago_in_words(review.created_at) %> ago</span>
            </div>

            <p class="mt-2 text-slate-700 whitespace-pre-wrap"><%= review.body %></p>
          </li>
        <% end %>
      <% end %>
    </ul>
  <% else %>
    <p class="text-slate-600">You have not left any reviews yet!</p>
  <% end %>
</div>
