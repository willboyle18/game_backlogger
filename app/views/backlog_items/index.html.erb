<div class="mb-8">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-semibold tracking-tight">My Backlog</h1>
  </div>

  <% if @backlog_items.empty? %>
    <p class="text-slate-600">Your backlog is empty.</p>
  <% else %>
    <ul class="space-y-3">
      <% @backlog_items.each do |item| %>
        <li class="flex items-center justify-between rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm hover:shadow transition">
          <%= link_to item.game.name, game_path(item.game.igdb_id),
                      class: "font-medium text-slate-800 hover:underline" %>

          <%= button_to "Remove",
                        backlog_item_path(item),
                        method: :delete,
                        form: { data: { turbo_confirm: "Remove from backlog?" } },
                        class: "rounded-md border border-slate-300 px-3 py-1 text-sm text-slate-700 hover:bg-slate-100" %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
