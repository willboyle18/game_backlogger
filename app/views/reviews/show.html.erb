<div class="max-w-2xl mx-auto mt-8">
  <h1 class="text-2xl font-semibold tracking-tight"><%= @review.user.username %>'s Review of <%= @review.game.name %></h1>
  <div class="mb-4">
    <%= link_to @review.game.name,
                game_path(@review.game.igdb_id),
                class: "text-blue-600 hover:underline text-sm" %>
  </div>
  <% if @review.game.cover_image_id.present? %>
    <img
      src=<%= @review.game.cover_url %>
        alt="<%= @review.game.name %> cover"
    class="h-64 w-48 rounded-lg object-cover shadow-md"
    loading="lazy" />
  <% end %>

  <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex justify-between items-center mb-3">
      <span class="text-sm text-slate-500"><%= time_ago_in_words(@review.created_at) %> ago</span>
    </div>

    <p class="text-slate-700 whitespace-pre-wrap"><%= @review.body %></p>
  </div>
  <div class="mb-8">
    <h1 class="text-2xl font-semibold tracking-tight">Comments</h1>
    <% if @comments.any? %>
      <ul class="space-y-4">
        <% @comments.each do |comment| %>
          <li class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
            <div class="flex justify-between items-center">
              <span class="font-medium text-slate-900"><%= comment.user.username %></span>
              <span class="text-sm text-slate-500"><%= time_ago_in_words(comment.created_at) %> ago</span>
            </div>
            <p class="mt-2 text-slate-700 whitespace-pre-wrap"><%= comment.body %></p>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-slate-600">This review has not received any comments yet! Be the first to write one!</p>
    <% end %>
  </div>

  <%= form_with model: [@review.game, @review, Comment.new] do |f| %>
    <%= f.text_area :body,
                    placeholder: "Leave a comment...",
                    rows: 6, cols: 60,
                    class: "border border-slate-300 rounded-md px-3 py-2 w-full" %>
    <%= f.submit "Post comment",
                 class: "bg-blue-600 hover:bg-blue-500 text-white rounded-md px-4 py-2 cursor-pointer mt-2" %>
  <% end %>
</div>