<h1><%= @game.name %></h1>
<% if @game.cover_image_id.present? %>
  <img
    src=<%= @game.cover_url %>
    alt="<%= @game.name %> cover"
    class="h-12 w-9 rounded object-cover ml-4"
    loading="lazy" />
<% end %>
<p><%= @game.summary %></p>

<div>
  Platforms:
  <%= @platform_names.join(", ") %>
</div>

<div>
  Release Year:
  <%= @game.release_year %>
</div>
