<h1><%= @game.name %></h1>
<% if @game.cover_image_id.present? %>
  <img
    src=<%= @game.cover_url %>
    alt="<%= @game.name %> cover"
    class="h-12 w-9 rounded object-cover ml-4"
    loading="lazy" />
<% end %>
<p><%= @game.summary %></p>

<div>
  Platforms:
  <%= @platform_names.join(", ") %>
</div>

<div>
  Release Year:
  <%= @game.release_year %>
</div>

<div>
  <% if Current.user.backlog_items.exists?(game_id: @game.id) %>
    <%= button_to "Remove from backlog",
                  backlog_item_path(Current.user.backlog_items.find_by(game_id: @game.id)),
                  method: :delete,
                  form: { data: { turbo_confirm: "Remove from backlog?" } },
                  class: "cursor-pointer rounded-md border border-slate-300 px-3 py-1 text-sm text-slate-700 hover:bg-slate-100" %>
  <% else %>
    <%= button_to "Add to backlog",
                  backlog_items_path(igdb_id: @game.igdb_id),
                  method: :post,
                  class: "cursor-pointer border" %>
  <% end %>
</div>

<!-- Reviews -->
<!-- Create a review -->
<%= form_with model: [@game, @review], url: game_reviews_path(@game.igdb_id) do |f| %>
  <%= f.text_area :body,
                  placeholder: "Write your review...",
                  rows: 6, cols: 60,
                  class: "border border-slate-300 rounded-md px-3 py-2 w-full" %>

  <%= f.submit "Post Review",
               class: "bg-blue-600 hover:bg-blue-500 text-white rounded-md px-4 py-2 cursor-pointer mt-2" %>
<% end %>

<hr class="my-6 border-slate-300">

<h2 class="text-xl font-semibold mb-3">Reviews</h2>

<% if @reviews.any? %>
  <ul class="space-y-4">
    <% @reviews.each do |review| %>
      <li class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
        <div class="flex justify-between items-center">
          <span class="font-medium text-slate-900"><%= review.user.username %></span>
          <span class="text-sm text-slate-500"><%= time_ago_in_words(review.created_at) %> ago</span>
        </div>

        <p class="mt-2 text-slate-700 whitespace-pre-wrap"><%= review.body %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-slate-600">No reviews yet. Be the first to write one!</p>
<% end %>
