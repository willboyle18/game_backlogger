# syntax=docker/dockerfile:1
FROM ruby:3.4

# Install required system packages
RUN apt-get update -qq && \
    apt-get install -y curl gnupg build-essential libpq-dev ca-certificates && \
    mkdir -p /usr/share/keyrings && \
    # Add NodeSource repository for latest Node.js
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    # Add Yarn’s official repo key (no apt-key)
    curl -fsSL https://dl.yarnpkg.com/debian/pubkey.gpg \
      | gpg --dearmor -o /usr/share/keyrings/yarnkey.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/yarnkey.gpg] https://dl.yarnpkg.com/debian/ stable main" \
      > /etc/apt/sources.list.d/yarn.list && \
    apt-get update -qq && \
    apt-get install -y yarn && \
    rm -rf /var/lib/apt/lists/*


# Set working directory
WORKDIR /app

# Install Ruby gems
COPY Gemfile Gemfile.lock ./
RUN bundle install

# Copy app source
COPY . .

# Expose Rails default port
EXPOSE 3000

# Run the Rails server in development mode
CMD ["bash", "-c", "bin/rails db:prepare && bin/rails server -b 0.0.0.0 -p 3000"]
